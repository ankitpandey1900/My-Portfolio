{
  // Set default code formatting parameters
  "editor.formatOnSave": true,

  // Configure linting actions to trigger on file save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Language specific formatter mappings
  "[typescript]": {
    "editor.suggest.insertMode": "replace"
  },
  "[typescriptreact]": {
    "editor.suggest.insertMode": "replace"
  },
  "[javascript]": {},
  "[css]": {},
  "[json]": {},
  "[markdown]": {},

  // Ignore Tailwind v4 custom at-rules warnings (@theme, @apply, @custom-variant)
  "css.lint.unknownAtRules": "ignore",

  // Hide generated build outputs from search indexes and vscode file explorer
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true,
    "**/*.tsbuildinfo": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true
  },

  // Auto-import preferences for absolute imports
  "typescript.preferences.importModuleSpecifier": "non-relative"
}
